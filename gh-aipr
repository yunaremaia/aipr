#!/usr/bin/env python3
"""gh-aipr: GitHub CLI extension wrapper for aipr (AI policy reader).

Delegates to aipr CLI with identical interface, preserving exit codes for CI:
  0 = autonomous-safe, 1 = restricted, 2 = unknown.

Install: copy this script to $PATH as gh-aipr, or run `gh extension install yunaremaia/aipr`.
"""

import os
import sys

# Ensure the package is importable when run from source
_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(_SCRIPT_DIR, "src"))

from aipr.cli import main

if __name__ == "__main__":
    sys.exit(main())
